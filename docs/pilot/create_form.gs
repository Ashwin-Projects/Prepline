// Generated by evaluation/pilot/build_form.py from evaluation/pilot/form_spec.py. Do not edit by hand.
// Run createPrepLinePilotForm() once at script.google.com; see docs/pilot/FORM.md.
function createPrepLinePilotForm() {
  var form = FormApp.create("PREPLINE pilot");
  form.setDescription("PREPLINE compares the VIT CSE syllabus with topics companies ask in interviews. This form takes about 10 minutes. Taking part is voluntary; you can skip questions and withdraw by giving the researcher your participant id before the analysis date. No name, email or roll number is collected. Answers are reported only as group averages.");
  // Never collect email addresses (newer API first, older API as fallback).
  try { form.setEmailCollectionType(FormApp.EmailCollectionType.DO_NOT_COLLECT); } catch (e) { form.setCollectEmail(false); }
  form.setAllowResponseEdits(false);
  form.setShowLinkToRespondAgain(false);

  // Section 1: consent, participant id, track
  var consent = form.addCheckboxItem().setTitle("Consent").setRequired(true);
  consent.setChoices([consent.createChoice("I have read the information sheet and agree that my anonymised answers are used in the PREPLINE pilot")]);
  form.addTextItem().setTitle("Participant ID (given to you by the researcher, e.g. P01)").setRequired(true)
    .setValidation(FormApp.createTextValidation().requireTextMatchesPattern('P[0-9]{2}').build());
  var track = form.addMultipleChoiceItem().setTitle("Which describes you?").setRequired(true);

  // Track A
  var pageA = form.addPageBreakItem().setTitle('Track A: your assessment or interview');
  var company = form.addMultipleChoiceItem().setTitle("Company and role you interviewed for").setRequired(true);
  form.addTextItem().setTitle("Exact role title (as in the offer or invitation)").setRequired(true);
  form.addCheckboxItem().setTitle("Rounds you took part in").setChoiceValues(["Online assessment", "Technical interview", "System design", "Hiring manager / behavioural", "Other"]);
  form.addCheckboxItem().setTitle("Topics you were actually asked about").setChoiceValues(["Two Pointers Technique", "Sliding Window Technique", "Prefix Sum", "Linked List Manipulation & Cycle Detection", "Monotonic Stack and Queue", "Tree Traversals", "Binary Search Trees", "Lowest Common Ancestor", "Top K Elements and K-Way Merge", "Graph Traversal (BFS & DFS)", "Shortest Path Algorithms", "Topological Sorting", "Disjoint Set Union (Union-Find)", "Binary Search", "1D Dynamic Programming", "Knapsack and Subset DP", "Grid Path Dynamic Programming", "String and Subsequence DP", "Subsets and Permutations", "SQL Aggregations and Grouping", "SQL Joins", "SQL Subqueries and Window Functions", "Normal Forms (1NF, 2NF, 3NF, BCNF)", "ACID Properties", "Transaction Isolation and Locking", "B-Trees and B+ Tree Indexing", "Context Switching and Process Control Block", "Multithreading and User/Kernel Threads", "CPU Scheduling Algorithms", "Semaphores, Mutexes, and Monitors", "Paging, TLB, and Segmentation", "Demand Paging and Page Replacement", "Deadlock Prevention and Banker's Algorithm", "OSI Model and TCP/IP Layers", "HTTP, HTTPS, and REST", "Domain Name System (DNS)", "TCP vs UDP Protocols", "TCP Handshake, Flow, and Congestion Control", "IP Addressing, Subnetting, and CIDR", "Routing Algorithms and Protocols", "TLS/SSL Handshake and Encryption", "Load Balancing Algorithms & Consistent Hashing", "Cache Invalidation & Eviction Strategies", "Database Sharding and Read Replicas", "Message Queue Patterns and Decoupling", "Rate Limiting and API Gateways", "None of these"]);

  // One gap-rating page per company with a PREPLINE profile
  var gapPages = {};
  gapPages["Amazon SDE-1"] = form.addPageBreakItem().setTitle("Gap relevance: Amazon SDE-1");
  form.addGridItem().setTitle("Gap relevance: Amazon SDE-1").setHelpText("How well does each gap match your real weak areas for this interview? 1 = not at all, 5 = exactly; N/A = can't judge.")
    .setRows(["1. Linked List Manipulation & Cycle Detection", "2. Monotonic Stack and Queue", "3. Lowest Common Ancestor", "4. Shortest Path Algorithms", "5. Top K Elements and K-Way Merge", "6. Grid Path Dynamic Programming", "7. Binary Search", "8. Binary Search Trees", "9. Tree Traversals"]).setColumns(["1", "2", "3", "4", "5", "N/A"]);
  gapPages["Microsoft SDE-1"] = form.addPageBreakItem().setTitle("Gap relevance: Microsoft SDE-1");
  form.addGridItem().setTitle("Gap relevance: Microsoft SDE-1").setHelpText("How well does each gap match your real weak areas for this interview? 1 = not at all, 5 = exactly; N/A = can't judge.")
    .setRows(["1. Linked List Manipulation & Cycle Detection", "2. Monotonic Stack and Queue", "3. Cache Invalidation & Eviction Strategies", "4. Message Queue Patterns and Decoupling", "5. Binary Search Trees", "6. Demand Paging and Page Replacement", "7. Subsets and Permutations", "8. Lowest Common Ancestor", "9. String and Subsequence DP", "10. Sliding Window Technique"]).setColumns(["1", "2", "3", "4", "5", "N/A"]);
  gapPages["Flipkart SDE-1"] = form.addPageBreakItem().setTitle("Gap relevance: Flipkart SDE-1");
  form.addGridItem().setTitle("Gap relevance: Flipkart SDE-1").setHelpText("How well does each gap match your real weak areas for this interview? 1 = not at all, 5 = exactly; N/A = can't judge.")
    .setRows(["1. String and Subsequence DP", "2. Lowest Common Ancestor", "3. Shortest Path Algorithms", "4. Top K Elements and K-Way Merge", "5. Tree Traversals", "6. B-Trees and B+ Tree Indexing", "7. Linked List Manipulation & Cycle Detection", "8. Sliding Window Technique", "9. Routing Algorithms and Protocols", "10. Subsets and Permutations"]).setColumns(["1", "2", "3", "4", "5", "N/A"]);

  // Track B
  var pageB = form.addPageBreakItem().setTitle('Track B: after about 5 minutes on the PREPLINE dashboard');
  form.addMultipleChoiceItem().setTitle("Company profile you looked at on the dashboard").setRequired(true).setChoiceValues(["Amazon SDE-1", "Microsoft SDE-1", "Flipkart SDE-1"]);
  form.addScaleItem().setTitle("These gaps match my perceived weak areas").setBounds(1, 5).setLabels('Not at all', 'Exactly').setRequired(true);

  // Usefulness (both tracks)
  var pageUse = form.addPageBreakItem().setTitle('Usefulness');
  form.addGridItem().setTitle("Usefulness").setHelpText("1 = strongly disagree, 5 = strongly agree.")
    .setRows(["The priority-gap list was easy to understand", "The gaps shown would help me plan my preparation", "The confidence information helped me judge how far to trust the results", "I would use PREPLINE before a real interview", "I would recommend PREPLINE to a classmate"]).setColumns(['1', '2', '3', '4', '5']);
  form.addParagraphTextItem().setTitle("Anything else? (optional)");

  // Navigation: track -> A or B; company -> its gap page (or Usefulness); every gap page and Track B end at Usefulness.
  track.setChoices([track.createChoice("I took an online assessment or interview with one of these companies (any outcome, including internships)", pageA), track.createChoice("I have not; I will look at the PREPLINE dashboard for about 5 minutes", pageB)]);
  company.setChoices([
    company.createChoice("Amazon SDE-1", gapPages["Amazon SDE-1"]),
    company.createChoice("Microsoft SDE-1", gapPages["Microsoft SDE-1"]),
    company.createChoice("Google SWE-L3", pageUse),
    company.createChoice("Flipkart SDE-1", gapPages["Flipkart SDE-1"]),
  ]);
  // A page break's goToPage decides where the section before it continues.
  var breaks = form.getItems(FormApp.ItemType.PAGE_BREAK).map(function (i) { return i.asPageBreakItem(); });
  var gapIds = Object.keys(gapPages).map(function (k) { return gapPages[k].getId(); });
  for (var b = 1; b < breaks.length; b++) {
    if (gapIds.indexOf(breaks[b - 1].getId()) >= 0) breaks[b].setGoToPage(pageUse);
  }
  Logger.log('Edit URL: ' + form.getEditUrl());
  Logger.log('Respondent URL: ' + form.getPublishedUrl());
}
